{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "BaseUrl": "http://localhost:8180",
    "Realm": "wisdom",
    "ClientId": "wisdom-app"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  },
  "InternalAuth": {
    "ApiKey": "wisdom-internal-2025"
  },
  "BackendServices": {
    "CourseApi": "http://localhost:5007",
    "OrderApi": "http://localhost:5009",
    "LearningApi": "http://localhost:5010"
  },
  "ReverseProxy": {
    "Routes": {
      "user-auth": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-users": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "courses-root": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/api/courses"
        }
      },
      "courses": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/api/courses/{**catch-all}"
        }
      },
      "media": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/media/{**catch-all}"
        }
      },
      "orders": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "progress-root": {
        "ClusterId": "learning-cluster",
        "Match": {
          "Path": "/api/progress"
        }
      },
      "progress": {
        "ClusterId": "learning-cluster",
        "Match": {
          "Path": "/api/progress/{**catch-all}"
        }
      },
      "stream": {
        "ClusterId": "stream-cluster",
        "Match": {
          "Path": "/stream/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006"
          }
        }
      },
      "course-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5007"
          }
        }
      },
      "media-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5008"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5009"
          }
        }
      },
      "learning-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "stream-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5011"
          }
        }
      }
    }
  }
}