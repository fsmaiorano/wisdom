{
  "version": "2.0.0",
  "tasks": [
    // ── Angular ──────────────────────────────────────────────────────────────
    {
      "label": "serve: Angular (local)",
      "type": "shell",
      "command": "npm run start",
      "options": { "cwd": "${workspaceFolder}/ui/wisdom-ui" },
      "isBackground": true,
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "angular",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Application bundle generation complete" },
          "endsPattern": { "regexp": "press h" }
        }
      }
    },
    {
      "label": "serve: Angular (docker)",
      "type": "shell",
      "command": "npx ng serve --configuration=docker",
      "options": { "cwd": "${workspaceFolder}/ui/wisdom-ui" },
      "isBackground": true,
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "angular",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Application bundle generation complete" },
          "endsPattern": { "regexp": "press h" }
        }
      }
    },

    // ── .NET builds ──────────────────────────────────────────────────────────
    {
      "label": "build: Bff",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/dotnet/Wisdom.Bff/Wisdom.Bff/Wisdom.Bff.csproj"
      ],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: User",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/dotnet/Wisdom.User/Wisdom.User.Api/Wisdom.User.Api.csproj"
      ],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Course",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/dotnet/Wisdom.Course/Wisdom.Course.Api/Wisdom.Course.Api.csproj"
      ],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Media",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/dotnet/Wisdom.Media/Wisdom.Media.Api/Wisdom.Media.Api.csproj"
      ],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Order",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/dotnet/Wisdom.Order/Wisdom.Order.Api/Wisdom.Order.Api.csproj"
      ],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Learning",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/dotnet/Wisdom.Learning/Wisdom.Learning.Api/Wisdom.Learning.Api.csproj"
      ],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },

    // ── Go builds ────────────────────────────────────────────────────────────
    {
      "label": "build: Go Worker",
      "command": "go",
      "type": "process",
      "args": ["build", "./cmd/worker"],
      "options": {
        "cwd": "${workspaceFolder}/go/worker"
      },
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$go"
    }
  ]
}
