      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Course",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/dotnet/Wisdom.Course/Wisdom.Course.Api/Wisdom.Course.Api.csproj"],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Media",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/dotnet/Wisdom.Media/Wisdom.Media.Api/Wisdom.Media.Api.csproj"],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Order",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/dotnet/Wisdom.Order/Wisdom.Order.Api/Wisdom.Order.Api.csproj"],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Learning",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/dotnet/Wisdom.Learning/Wisdom.Learning.Api/Wisdom.Learning.Api.csproj"],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },

    // ── Go builds ────────────────────────────────────────────────────────────
    {
      "label": "build: Go Worker",
      "command": "go",
      "type": "process",
      "args": ["build", "./cmd/worker"],
      "options": {
        "cwd": "${workspaceFolder}/go/worker"
      },
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$go"
