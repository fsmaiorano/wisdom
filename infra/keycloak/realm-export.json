{
  "realm": "wisdom",
  "displayName": "Wisdom",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,

  "clients": [
    {
      "clientId": "wisdom-app",
      "name": "Wisdom App",
      "description": "Wisdom application client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,

      "redirectUris": ["*"],
      "webOrigins": ["*"],

      "protocol": "openid-connect",

      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],

      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],

      "protocolMappers": [
        {
          "name": "userId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "userId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "teacher",
        "description": "Teacher role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "customer",
        "description": "Customer role",
        "composite": false,
        "clientRole": false
      }
    ]
  },

  "users": [
    {
      "username": "admin",
      "email": "admin@wisdom.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "123456!",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "default-roles-wisdom"]
    },
    {
      "username": "user",
      "email": "user@wisdom.com",
      "firstName": "Regular",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "123456!",
          "temporary": false
        }
      ],
      "realmRoles": ["customer", "default-roles-wisdom"]
    },
    {
      "username": "Customer Demo",
      "email": "customer@wisdom.dev",
      "firstName": "Customer",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "democustomer",
          "temporary": false
        }
      ],
      "realmRoles": ["customer", "default-roles-wisdom"]
    },
    {
      "username": "teacher",
      "email": "teacher@wisdom.com",
      "firstName": "Teacher",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "123456!",
          "temporary": false
        }
      ],
