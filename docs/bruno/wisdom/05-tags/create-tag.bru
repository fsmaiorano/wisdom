meta {
  name: Create Tag
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "JavaScript"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("tagId", res.body.id);
  }
}
