{
  "folders": [
    { "name": "Wisdom (root)",   "path": "." },
    { "name": "Angular — UI",    "path": "ui/wisdom-ui" },
    { "name": ".NET — Bff",      "path": "dotnet/Wisdom.Bff" },
    { "name": ".NET — User",     "path": "dotnet/Wisdom.User" },
    { "name": ".NET — Course",   "path": "dotnet/Wisdom.Course" },
    { "name": ".NET — Media",    "path": "dotnet/Wisdom.Media" },
    { "name": ".NET — Order",    "path": "dotnet/Wisdom.Order" },
    { "name": ".NET — Learning", "path": "dotnet/Wisdom.Learning" },
    { "name": ".NET — MediaWorker", "path": "dotnet/Wisdom.MediaWorker" },
    { "name": ".NET — Streaming", "path": "dotnet/Wisdom.Streaming" }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.rulers": [120],

    "dotnet.defaultSolution": "dotnet/Wisdom.sln",
    "omnisharp.useModernNet": true,
    "csharp.debug.console": "internalConsole",

    "files.exclude": { "**/bin": true, "**/obj": true },
    "search.exclude": { "**/bin": true, "**/obj": true }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csdevkit",
      "ms-dotnettools.csharp",
      "ms-dotnettools.vscode-dotnet-runtime",
      "angular.ng-template",
      "ms-edgedevtools.vscode-edge-devtools"
    ]
  }
}
